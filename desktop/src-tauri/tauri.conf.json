{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Watchdog",
  "version": "0.3.0",
  "identifier": "io.github.itbaymax.claudewatchdog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Claude Watchdog - Claude 桌面版更新看门狗",
        "width": 1120,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Claude Watchdog"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Claude Desktop update watchdog",
    "longDescription": "Detects failed Claude Desktop (MSIX) self-updates on Windows, stops the leftover processes of the previous version, relaunches Claude, and cleans up orphaned package folders.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ItBayMax/claude-update-watchdog/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MkMxNTZCQzZGRjNGMjAKUldRZ1AvL0dheFVzUk91b2tONTRlVFhKS3ZRU2xtQ2sxM2VlWWQzWXl5cC9XTU1IcnAreEt4cFEK"
    }
  }
}
